def chat_send(text, rows):
    with CHAT_LOCK: _chat_send(text, rows)

def _chat_send(text, rows):
    global CHAT_SID, CHAT_PROC, CHAT_T0
    if text == "/clear":
        CHAT.clear(); CHAT_SID = None
        return
    if CHAT_PROC:
        CHAT.append(("err", "still working on the previous request"))
        return
    import threading, uuid
    os.makedirs(CHAT_DIR, exist_ok=True)
    live = "\n".join(f"- {r['name'] or r['sid'][:8]} · {r['status']} · {r['cwd']}" for r in rows if r["live"])
    prompt = f"<dashboard>\nLive Claude sessions (name · status · dir):\n{live or '- none'}\n</dashboard>\n\n{text}"
    resume = bool(CHAT_SID and transcript(CHAT_SID))
    CHAT_SID = CHAT_SID or str(uuid.uuid4())
    cmd = [shutil.which("claude") or os.path.expanduser("~/.local/bin/claude"), "-p", prompt,
        "--model", CHAT_MODEL, "--permission-mode", "bypassPermissions", "--output-format", "stream-json", "--verbose",
        "--append-system-prompt", chat_system(), "--resume" if resume else "--session-id", CHAT_SID]
    CHAT.append(("you", text))
    CHAT_T0 = time.time()
    try:
        CHAT_PROC = subprocess.Popen(cmd, cwd=CHAT_DIR, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT, text=True, start_new_session=True)
    except OSError as e:
        CHAT.append(("err", f"cannot start claude: {e}"))
        return
    threading.Thread(target=chat_read, args=(CHAT_PROC,), daemon=True).start()

def chat_read(p):
    global CHAT_PROC
    replied, noise = False, []
    for line in p.stdout:
        try: d = json.loads(line)
        except Exception:
            if line.strip(): noise.append(line.strip())
            continue
        t = d.get("type")
        if t == "assistant":
            for x in d.get("message", {}).get("content") or []:
                if x.get("type") == "text" and x.get("text", "").strip():
                    CHAT.append(("claude", x["text"].strip())); replied = True
                elif x.get("type") == "tool_use":
                    CHAT.append(("tool", tool_line(x)))
        elif t == "user":
            for x in d.get("message", {}).get("content") or []:
                if isinstance(x, dict) and x.get("type") == "tool_result" and x.get("is_error"):
                    c = x.get("content")
                    if isinstance(c, list): c = " ".join(y.get("text", "") for y in c if isinstance(y, dict))
                    CHAT.append(("err", str(c)[:300]))
        elif t == "result" and d.get("is_error"):
            CHAT.append(("err", str(d.get("result") or d.get("subtype") or "request failed"))); replied = True
    p.wait()
    if p.returncode and not replied:
        CHAT.append(("err", noise[-1] if noise else f"claude exited with code {p.returncode}"))
    CHAT_PROC = None

def chat_lines(entries, inner):
    import textwrap
    T = lambda n: f"\033[38;5;{n}m"
    Z = "\033[0m"
    ORANGE, GRAY, RED, FG, MID, UBG = T(173), T(240), T(167), T(253), T(245), "\033[48;5;236m"
    home = os.path.expanduser("~")
    log = []
    for kind, text in entries:
        if kind == "tool":
            cmd = (str(text).splitlines() or [""])[0].replace(home, "~")
            log.append(f"  {GRAY}⎿{Z}  {MID}{clip(cmd, inner - 5)}{Z}")
            continue
        for i, seg in enumerate(textwrap.wrap(" ".join(str(text).split()), inner - 3) or [""]):
            first = i == 0
            if kind == "you":
                log.append(f"{UBG}{FG}" + pad(f" {'›' if first else ' '} {seg}", inner) + Z)
            elif kind == "claude":
                log.append(f"{ORANGE}{'⏺' if first else ' '}{Z} {FG}{seg}{Z}")
            else:
                log.append(f"{RED}{'✗' if first else ' '} {seg}{Z}")
    return log

def chat_view(cols):
    T = lambda n: f"\033[38;5;{n}m"
    Z, B, D = "\033[0m", "\033[1m", "\033[2m"
    ORANGE, GRAY, FG = T(173), T(240), T(253)
    on = INPUT is not None
    W = max(30, cols - 1)
    inner = W - 4
    bd = ORANGE if on else GRAY
    log = chat_lines(CHAT, inner)
    if CHAT_PROC:
        log.append(f"{ORANGE}{'·✢✳✶✻✽✻✶✳✢'[FRAME % 10]} Working…{Z} {D}{int(time.time() - CHAT_T0)}s{Z}")
    tip = "open a repo in VS Code, show it in Finder…"
    if not on:
        field = f"{GRAY}❯{Z} {D}{clip('press / to ask Claude · ' + tip, inner - 2)}{Z}"
    elif INPUT:
        room = inner - 3
        cur = "\033[7m \033[27m" if FRAME // 3 % 2 == 0 else " "
        field = f"{ORANGE}{B}❯{Z} {FG}{B}{INPUT[-room:] if vw(INPUT) > room else INPUT}{Z}{cur}"
    else:
        cur = "\033[7m \033[27m" if FRAME // 3 % 2 == 0 else " "
        field = f"{ORANGE}{B}❯{Z} {cur}{D}{clip(tip, inner - 3)}{Z}"
    head = f"{bd}╭─{Z} {ORANGE}{B}✻ Ask Claude{Z} "
    side = f" {D}{CHAT_MODEL} · {'enter send · esc close' if on else '/ to type'}{Z} {bd}─╮{Z}"
    row = lambda x: f"{bd}│{Z} {pad(x, inner)} {bd}│{Z}"
    out = [head + f"{bd}{'─' * max(0, W - vw(head) - vw(side))}{Z}" + side]
    if log:
        out += [row(x) for x in log[-CHAT_ROWS:]] + [f"{bd}├{'─' * (W - 2)}┤{Z}"]
    return out + [row(field), f"{bd}╰{'─' * (W - 2)}╯{Z}"]

def server(port):
    import threading, secrets
    from http.server import ThreadingHTTPServer, BaseHTTPRequestHandler
    from urllib.parse import urlparse, parse_qs
    web = os.path.join(ROOT, "web")
    page = os.path.join(web, "index.html")
    STATIC = {"/manifest.webmanifest": "application/manifest+json", "/sw.js": "text/javascript; charset=utf-8"}
    token = secrets.token_urlsafe(24)
    cache, lock = {}, threading.Lock()

    def sessions(ended, fresh=False):
        with lock:
            t, rows = cache.get(ended, (0, []))
            if fresh or time.time() - t >= 2:
                rows = collect(ended)
                cache[ended] = (time.time(), rows)
            return rows

    def themes():
        c = settings()
        lst = [dict(id=str(t["id"]), title=str(t.get("title") or t["id"]), file=t["file"]) for t in c.get("themes") or []
               if isinstance(t, dict) and t.get("id") and re.fullmatch(r"[A-Za-z0-9_-]+\.css", str(t.get("file", "")))]
        lst = lst or [dict(id="terminal", title="Terminal", file="Terminal-theme.css")]
        cur = next((t for t in lst if t["id"] == c.get("theme")), lst[0])
        return c, lst, cur

    def chat_state():
        return dict(log=[list(x) for x in CHAT], working=CHAT_PROC is not None, t0=CHAT_T0)

    def tasks_state():
        try:
            live = {r["sid"]: r for r in sessions(False) if r["live"]}
            task_sync(live)
            lst = task_list()
            for t in lst:
                r = live.get(t["session_id"])
                t["sess"] = r and dict(status=r["status"], act=r.get("cur_task") or "")
            return dict(list=lst, err=None, inbox=inbox_state())
        except Exception as e:
            return dict(list=[], err=f"tasks db: {e}", inbox=None)

    class H(BaseHTTPRequestHandler):
        def log_message(self, *a): pass

        def reply(self, code, body, ctype="application/json; charset=utf-8"):
            data = body if isinstance(body, bytes) else json.dumps(body).encode()
            try:
                self.send_response(code)
                self.send_header("Content-Type", ctype)
                self.send_header("Content-Length", str(len(data)))
                self.send_header("Cache-Control", "no-store")
                self.send_header("X-Content-Type-Options", "nosniff")
                self.send_header("Content-Security-Policy", "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'none'")
                self.end_headers()
                self.wfile.write(data)
            except OSError:
                pass

        def allowed(self, api):
            p = self.server.server_address[1]
            if self.headers.get("Host") not in (f"127.0.0.1:{p}", f"localhost:{p}"):
                self.reply(403, {"error": "bad host"}); return False
            if api and not secrets.compare_digest(self.headers.get("X-CS-Token", ""), token):
                self.reply(403, {"error": "bad token"}); return False
            return True

        def do_GET(self):
            u = urlparse(self.path)
            if not self.allowed(u.path.startswith("/api/")): return
            if u.path == "/":
                try: html = open(page, encoding="utf-8").read()
                except OSError as e: return self.reply(500, f"cannot read {page}: {e}".encode(), "text/plain; charset=utf-8")
                html = html.replace("__CS_TOKEN__", token).replace("__CS_THEME__", f"/themes/{themes()[2]['file']}")
                return self.reply(200, html.encode(), "text/html; charset=utf-8")
            ctype = (STATIC.get(u.path) or ("image/png" if re.fullmatch(r"/icons/[a-z0-9-]+\.png", u.path) else None)
                or ("text/css; charset=utf-8" if re.fullmatch(r"/themes/[A-Za-z0-9_-]+\.css", u.path) else None))
            if ctype:
                try: data = open(os.path.join(web, u.path.lstrip("/")), "rb").read()
                except OSError: return self.reply(404, {"error": "not found"})
                return self.reply(200, data, ctype)
            if u.path == "/api/state":
                q = parse_qs(u.query)
                rows = sessions(q.get("all") == ["1"], q.get("fresh") == ["1"])
                if q.get("tx") == ["1"]:
                    info = ps_info()
                    rows = [dict(r, tx=transcript_of(r, info)) for r in rows]
                _, lst, cur = themes()
                return self.reply(200, dict(sessions=rows, usage=usage_data(), chat=chat_state(), now=time.time(), projects=projects(), tasks=tasks_state(),
                    cfg=dict(themes=lst, theme=cur["id"], projects=dict(dir=str(settings().get("projects") or "~/Projects"), env=bool(os.environ.get("CS_REPO_ROOTS"))), window=WINDOW, agent_rows=AGENT_ROWS, chat_rows=CHAT_ROWS, chat_model=CHAT_MODEL, terminal=dict(app=task_terminal(), list=terminals()), home=os.path.expanduser("~"))))
            if u.path == "/api/task":
                tid = (parse_qs(u.query).get("id") or [""])[0]
                if not tid.isdigit(): return self.reply(400, {"error": "bad id"})
                try: t = task_get(int(tid))
                except Exception as e: return self.reply(500, {"error": f"tasks db: {e}"})
                return self.reply(200, t) if t else self.reply(404, {"error": "task not found"})
            if u.path == "/api/inbox":
                try: return self.reply(200, inbox_log())
                except Exception as e: return self.reply(500, {"error": f"tasks db: {e}"})
            self.reply(404, {"error": "not found"})

        def do_POST(self):
            u = urlparse(self.path)
            if not self.allowed(True): return
            try:
                n = int(self.headers.get("Content-Length") or 0)
                body = json.loads(self.rfile.read(min(n, 65536)) or b"{}") if n else {}
            except (ValueError, OSError):
                return self.reply(400, {"error": "bad body"})
            if u.path == "/api/focus":
                sid = body.get("sid")
                with lock:
                    row = next((r for _, rows in cache.values() for r in rows if r["sid"] == sid), None)
                return self.reply(200, {"msg": focus(row) if row else "session not found"})
            if u.path == "/api/session/new":
                cwd = os.path.expanduser(str(body.get("cwd") or "").strip())
                sid, err = own_start(cwd, None, str(body.get("mode") or "default"), str(body.get("text") or ""))
                with lock: cache.clear()
                return self.reply(400, {"error": err}) if err else self.reply(200, {"sid": sid, "msg": f"started a session in {os.path.basename(cwd)}"})
            if u.path in ("/api/session/answer", "/api/session/stop"):
                sid = str(body.get("sid") or "")
                msg = own_answer(sid, bool(body.get("allow"))) if u.path == "/api/session/answer" else own_stop(sid)
                with lock: cache.clear()
                return self.reply(200, {"msg": msg})
            if u.path == "/api/session/send":
                sid = body.get("sid")
                with lock:
                    row = next((r for _, rows in cache.values() for r in rows if r["sid"] == sid), None)
                return self.reply(200, {"msg": session_send(row, str(body.get("text") or "")) if row else "session not found"})
            if u.path == "/api/theme":
                t = next((t for t in themes()[1] if t["id"] == body.get("id")), None)
                if not t: return self.reply(400, {"error": "unknown theme"})
                try: save_settings(theme=t["id"])
                except OSError as e: return self.reply(500, {"error": f"cannot write {SETTINGS}: {e.strerror}"})
                return self.reply(200, {"theme": t["id"]})
            if u.path == "/api/open":
                return self.reply(200, {"msg": open_project(str(body.get("path") or ""))})
            if u.path == "/api/settings":
                d = str(body.get("projects") or "").strip().rstrip("/") or "~/Projects"
                if not all(os.path.isdir(os.path.expanduser(x.strip())) for x in d.split(":")):
                    return self.reply(400, {"error": f"not a folder: {d}"})
                try: save_settings(projects=d)
                except OSError as e: return self.reply(500, {"error": f"cannot write {SETTINGS}: {e.strerror}"})
                return self.reply(200, {"projects": d})
            if u.path == "/api/terminal":
                if body.get("app") not in terminals(): return self.reply(400, {"error": "terminal not installed"})
                try: save_settings(terminal=body["app"])
                except OSError as e: return self.reply(500, {"error": f"cannot write {SETTINGS}: {e.strerror}"})
                return self.reply(200, {"terminal": body["app"]})
            if u.path == "/api/chat":
                text = str(body.get("text") or "").strip()
                if text: chat_send(text, sessions(False))
                return self.reply(200, chat_state())
            if u.path in ("/api/task", "/api/task/delete"):
                try:
                    if u.path == "/api/task": t, err = task_save(body)
                    else: t, err = ({"deleted": body["id"]}, None) if isinstance(body.get("id"), int) and task_delete(body["id"]) else (None, "task not found")
                except Exception as e:
                    return self.reply(500, {"error": f"tasks db: {e}"})
                return self.reply(400, {"error": err}) if err else self.reply(200, t)
            if u.path in ("/api/task/session", "/api/task/open"):
                if not isinstance(body.get("id"), int): return self.reply(400, {"error": "bad id"})
                try:
                    if u.path == "/api/task/session":
                        t, err = task_session(body["id"], bool(body.get("resume")))
                        return self.reply(400, {"error": err}) if err else self.reply(200, t)
                    t = task_get(body["id"])
                except Exception as e:
                    return self.reply(500, {"error": f"tasks: {e}"})
                if not t or not t["repo"]: return self.reply(400, {"error": "this task has no repo"})
                d = (t.get("changes") or {}).get("worktree") or t["repo"]
                r = _run(["open", "-a", "Visual Studio Code", d], capture_output=True, text=True)
                return self.reply(200, {"msg": f"opened {os.path.basename(d)} in VS Code" if r.returncode == 0 else f"could not open VS Code: {(r.stderr or '').strip()[:120]}"})
            if u.path == "/api/inbox/scan":
                return self.reply(200, {"msg": inbox_start("manual")})
            if u.path == "/api/inbox/settings":
                cur = settings().get("inbox")
                cur = dict(cur) if isinstance(cur, dict) else {}
                if "auto" in body: cur["auto"] = bool(body["auto"])
                if "every" in body:
                    if not isinstance(body["every"], int) or body["every"] < 5: return self.reply(400, {"error": "every must be at least 5 minutes"})
                    cur["every"] = body["every"]
                try: save_settings(inbox=cur)
                except OSError as e: return self.reply(500, {"error": f"cannot write {SETTINGS}: {e.strerror}"})
                return self.reply(200, inbox_cfg())
            self.reply(404, {"error": "not found"})

    srv = ThreadingHTTPServer(("127.0.0.1", port), H)
    srv.daemon_threads = True
    threading.Thread(target=inbox_poller, daemon=True).start()
    if not os.path.isfile(page): print(f"warning: {page} not found", file=sys.stderr)
    return srv

def ours(port):
    import urllib.request
    try:
        with urllib.request.build_opener(urllib.request.ProxyHandler({})).open(f"http://127.0.0.1:{port}/manifest.webmanifest", timeout=0.5) as r:
            return json.load(r).get("name") == "Claude sessions"
    except Exception:
        return False

def web_start():
    global WEB_URL
    port = os.environ.get("CS_PORT", "")
    fixed = port.isdigit()
    port = int(port) if fixed else 7421
    try: srv = server(port)
    except OSError as e:
        if ours(port):
            WEB_URL = f"http://127.0.0.1:{port}"
            return None, ""
        if fixed: return None, f"web: cannot listen on 127.0.0.1:{port}: {e.strerror}"
        try: srv = server(0)
        except OSError as e: return None, f"web: cannot start: {e.strerror}"
    WEB_URL = f"http://127.0.0.1:{srv.server_address[1]}"
    return srv, ""

def web_app():
    import plistlib
    from urllib.parse import urlparse
    port = urlparse(WEB_URL).port
    for app in glob.glob(os.path.expanduser("~/Applications/*.app")) + glob.glob(os.path.expanduser("~/Applications/*/*.app")):
        try:
            with open(os.path.join(app, "Contents", "Info.plist"), "rb") as f: u = urlparse(plistlib.load(f).get("CrAppModeShortcutURL") or "")
        except Exception:
            continue
        if u.hostname in ("127.0.0.1", "localhost") and u.port == port: return app
    return None

def open_web():
    app = web_app()
    _run(["open", "-a", app] if app else ["open", WEB_URL])

def serve(srv):
    print(f"claude-sessions web: http://127.0.0.1:{srv.server_address[1]}  (ctrl-c to stop)", flush=True)
    try: srv.serve_forever()
    except KeyboardInterrupt: pass
    finally:
        if CHAT_PROC: CHAT_PROC.terminate()
        if INBOX["proc"]: INBOX["proc"].terminate()
        for o in OWNED.values(): o["p"].terminate()
        srv.server_close()

def tx_start(row, msg):
    t = TXD.get(row["sid"])
    if t and t["mode"] == "none":
        return None, (f"this session runs in {t['app']}: f focuses it" if t["app"] else "this session has no terminal to type into", time.time())
    return "", msg

