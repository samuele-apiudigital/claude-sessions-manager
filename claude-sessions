#!/bin/sh
# Usage: claude-sessions [-a|--all] [-w|--web] [-j|--json] [-s|--serve [PORT]]
#   default: live sessions only; -a also lists recent finished transcripts (last 24h)
#   -s serves the dashboard as a web page on 127.0.0.1 (default port 7421, or $CS_PORT)
#   -w opens that web page in the browser instead of the terminal dashboard
export CS_SELF="$0"
exec python3 -I - "$@" <<'PY'
import json, os, sys, glob, time, subprocess, shutil, re, threading
from datetime import datetime
args = sys.argv[1:]
ISTTY = sys.stdout.isatty()
FRAME = 0
SEL = None
TILES = []
MSG = ("", 0.0)
show_all = any(a in ("-a", "--all") for a in args)
as_json = any(a in ("-j", "--json") for a in args)
table = any(a in ("-t", "--table") for a in args)
watch = False
web_only = any(a in ("-w", "--web") for a in args)
HOME = os.path.expanduser("~/.claude")
WINDOW = int(os.environ.get("CLAUDE_CTX_WINDOW", "0"))
CHAT_DIR = f"{HOME}/state/cs-chat"
TASKS_DB = os.path.expanduser(os.environ.get("CS_TASKS_DB") or f"{HOME}/state/cs-tasks.db")
INBOX_DIR = f"{HOME}/state/cs-inbox"
TASK_DIR = f"{HOME}/state/cs-task-sessions"
INBOX_MODEL = os.environ.get("CS_INBOX_MODEL", "haiku")
CHAT_MODEL = os.environ.get("CS_CHAT_MODEL", "haiku")
CHAT_ROWS = int(os.environ.get("CS_CHAT_ROWS", "8"))
AGENT_ROWS = max(2, int(os.environ.get("CS_AGENT_ROWS", "4")))
ROOT = os.path.dirname(os.path.realpath(os.environ.get("CS_SELF") or "."))
SETTINGS = os.path.join(ROOT, ".settings.json")
SLOCK = threading.Lock()
CHAT, CHAT_SID, CHAT_PROC, INPUT, CHAT_T0 = [], None, None, None, 0.0
PROJ, PSEARCH, PSEL, PROJ_HITS, PROJ_Y = [], None, 0, [], 0
VIEW, SEND, TXD, TX_ROOM, TX_LINES, PNEW, TX_SIZE = "tiles", None, {}, 20, {}, False, {}
TX_SIZES = ((1, 1), (2, 1), (2, 2))
WEB_URL, WEB_HIT, WEB_LABEL = None, None, "open web view ↗"
CHAT_LOCK = threading.Lock()
INBOX, INBOX_LOCK = dict(proc=None, t0=0.0, trigger=""), threading.Lock()

def alive(pid):
    try: os.kill(pid, 0); return True
    except OSError: return False

def etime(pid):
    try: return subprocess.check_output(["ps", "-p", str(pid), "-o", "etime="], text=True).strip()
    except Exception: return "-"

def fmt(n):
    return f"{n/1e6:.1f}M" if n >= 1e6 else f"{n/1e3:.0f}k" if n >= 1e3 else str(n)

def ago(ms):
    s = max(0, int(time.time() - ms/1000))
    return f"{s}s" if s < 60 else f"{s//60}m" if s < 3600 else f"{s//3600}h{s%3600//60:02d}m" if s < 86400 else f"{s//86400}d"

def dur(sec):
    sec = int(max(0, sec))
    return f"{sec}s" if sec < 60 else f"{sec//60}m{sec%60:02d}s" if sec < 3600 else f"{sec//3600}h{sec%3600//60:02d}m"

def epoch(ts):
    try: return datetime.fromisoformat(ts.replace("Z", "+00:00")).timestamp()
    except Exception: return None

def tag(text, name):
    m = re.search(f"<{name}>(.*?)</{name}>", text, re.S)
    return m.group(1).strip() if m else None

def transcript(sid):
    m = glob.glob(f"{HOME}/projects/*/{sid}.jsonl")
    return m[0] if m else None

def stats(path):
    s = dict(model="-", ctx=0, peak=0, turns=0, out=0, inp=0, cread=0, ccreate=0, tools=0, hist=[], title="", branch="", wd="", ultra=False, prompt="", cur_task="", done_task="", subjects=None, ncreate=0, first=None, last=None, agents=[])
    s["subjects"] = {}
    if not path: return s
    ag, by_task, pend = {}, {}, {}
    def notified(text, ts):
        for blk in text.split("<task-notification>")[1:]:
            a = ag.get(by_task.get(tag(blk, "task-id"))) or ag.get(tag(blk, "tool-use-id"))
            if not a: continue
            a["wait"] = "background work" in f"{tag(blk, 'summary')} {tag(blk, 'note')}"
            if a["state"] == "running" and not a["wait"]:
                a["state"], a["t1"] = tag(blk, "status") or "completed", epoch(ts)
    with open(path, errors="ignore") as f:
        for line in f:
            try: d = json.loads(line)
            except Exception: continue
            t = d.get("type")
            if t == "queue-operation" and "<task-notification>" in str(d.get("content") or ""):
                notified(str(d["content"]), d.get("timestamp"))
            if t == "ai-title": s["title"] = d.get("aiTitle", "")
            if t == "attachment":
                at = (d.get("attachment") or {}).get("type")
                if at == "ultra_effort_enter": s["ultra"] = True
                elif at == "ultra_effort_exit": s["ultra"] = False
            if t == "last-prompt": s["prompt"] = d.get("lastPrompt", "") or s["prompt"]
            if d.get("gitBranch"): s["branch"] = d["gitBranch"]
            if d.get("cwd"): s["wd"] = d["cwd"]
            ts = d.get("timestamp")
            if ts:
                s["first"] = s["first"] or ts
                s["last"] = ts
            if t == "user" and not d.get("isSidechain"):
                c = d.get("message", {}).get("content")
                if isinstance(c, str) or (isinstance(c, list) and any(x.get("type") == "text" for x in c if isinstance(x, dict))):
                    s["turns"] += 1
                text = c if isinstance(c, str) else " ".join(x.get("text", "") for x in c if isinstance(x, dict) and x.get("type") == "text") if isinstance(c, list) else ""
                if "<task-notification>" in text: notified(text, ts)
                res = d.get("toolUseResult") if isinstance(d.get("toolUseResult"), dict) else {}
                for x in c if isinstance(c, list) else []:
                    if not (isinstance(x, dict) and x.get("type") == "tool_result"): continue
                    uid = x.get("tool_use_id")
                    if uid in ag:
                        a = ag[uid]
                        if res.get("isAsync") or res.get("status") == "async_launched":
                            a["aid"], a["run"] = res.get("agentId"), res.get("runId")
                            if a["kind"] == "workflow": a["desc"] = res.get("workflowName") or a["desc"]
                            for k in (res.get("agentId"), res.get("taskId")):
                                if k: by_task[k] = uid
                        elif a["state"] == "running":
                            a["state"], a["t1"] = "failed" if x.get("is_error") else "completed", epoch(ts)
                    elif uid in pend:
                        nm, target = pend.pop(uid)
                        a = ag.get(by_task.get(target))
                        if not a or x.get("is_error"): continue
                        if nm == "TaskStop": a["state"], a["t1"] = "stopped", epoch(ts)
                        elif res.get("resumedAgentId"): a["state"], a["t1"] = "running", None
            if t == "assistant":
                m = d.get("message", {})
                u = m.get("usage") or {}
                if m.get("model") and not m["model"].startswith("<"): s["model"] = m["model"]
                i, cr, cc, o = (u.get(k, 0) or 0 for k in ("input_tokens", "cache_read_input_tokens", "cache_creation_input_tokens", "output_tokens"))
                if not d.get("isSidechain"):
                    s["ctx"] = i + cr + cc
                    s["peak"] = max(s["peak"], s["ctx"])
                    s["hist"].append(s["ctx"])
                s["inp"] += i; s["cread"] += cr; s["ccreate"] += cc; s["out"] += o
                for x in m.get("content", []):
                    if not (isinstance(x, dict) and x.get("type") == "tool_use"): continue
                    s["tools"] += 1
                    inp = x.get("input") or {}
                    nm = x.get("name")
                    if d.get("isSidechain"): pass
                    elif nm in ("Agent", "Task"):
                        ag[x["id"]] = dict(id=x["id"], kind="agent", type=inp.get("subagent_type") or "general-purpose",
                            desc=inp.get("description") or "", state="running", t0=epoch(ts), t1=None, aid=None, run=None)
                    elif nm == "Workflow":
                        mn = re.search(r"\bname:\s*['\"]([^'\"]+)", str(inp.get("script") or ""))
                        ag[x["id"]] = dict(id=x["id"], kind="workflow", type="workflow", desc=inp.get("name") or (mn.group(1) if mn else "workflow"),
                            state="running", t0=epoch(ts), t1=None, aid=None, run=None)
                    elif nm in ("TaskStop", "SendMessage"):
                        pend[x["id"]] = (nm, inp.get("task_id") or inp.get("shell_id") or inp.get("to"))
                    if nm == "TaskCreate":
                        s["ncreate"] += 1
                        s["subjects"][str(s["ncreate"])] = inp.get("subject", "")
                    elif nm == "TaskUpdate":
                        tid, st_ = str(inp.get("taskId", "")), inp.get("status")
                        text = inp.get("activeForm") or s["subjects"].get(tid, "")
                        if st_ == "in_progress":
                            s["cur_task"], s["cur_id"] = text, tid
                        elif st_ in ("completed", "deleted"):
                            s["done_task"] = s["subjects"].get(tid) or text or s["done_task"]
                            if s.get("cur_id") == tid: s["cur_task"] = ""
    s["hist"] = s["hist"][-36:]
    s["agents"] = list(ag.values())
    return s

def activity(path):
    try:
        with open(path, "rb") as f:
            f.seek(0, 2); f.seek(max(0, f.tell() - 65536))
            raw = f.read().decode(errors="ignore")
    except (OSError, TypeError):
        return ""
    for line in reversed(raw.splitlines()):
        try: d = json.loads(line)
        except Exception: continue
        c = (d.get("message") or {}).get("content")
        if d.get("type") == "user":
            return "thinking" if isinstance(c, list) and any(isinstance(x, dict) and x.get("type") == "tool_result" for x in c) else "starting"
        if d.get("type") == "assistant":
            used = [x.get("name", "") for x in c or [] if isinstance(x, dict) and x.get("type") == "tool_use"]
            if used: return used[-1].split("__")[-1]
            return "finishing" if d["message"].get("stop_reason") == "end_turn" else "thinking"
    return "starting"

def agent_detail(path, agents, live, since):
    if not path: return
    base = os.path.join(os.path.dirname(path), os.path.basename(path)[:-6], "subagents")
    by_use = None
    for a in agents:
        if a["state"] == "running" and not (live and (a["t0"] or 0) * 1000 >= since - 5000):
            a["state"] = "lost"
        if a["kind"] == "workflow":
            started, finished, a["phase"] = set(), set(), ""
            try:
                with open(os.path.join(base, "workflows", a["run"] or "-", "journal.jsonl"), errors="ignore") as f:
                    for line in f:
                        try: e = json.loads(line)
                        except Exception: continue
                        if e.get("type") == "started":
                            started.add(e.get("key")); a["phase"] = e.get("phase") or a["phase"]
                        elif e.get("type") == "result": finished.add(e.get("key"))
            except OSError:
                pass
            a["nrun"] = len(started - finished) if a["state"] == "running" else 0
            a["ndone"] = len(started) - a["nrun"]
        elif a["state"] == "running":
            f = os.path.join(base, f"agent-{a['aid']}.jsonl") if a["aid"] else None
            if not f:
                if by_use is None:
                    by_use = {}
                    for mf in glob.glob(os.path.join(base, "agent-*.meta.json")):
                        try: by_use[json.load(open(mf)).get("toolUseId")] = mf[:-10] + ".jsonl"
                        except Exception: pass
                f = by_use.get(a["id"])
            a["act"] = activity(f)
            if a.get("wait") and a["act"] == "finishing": a["act"] = "waiting"

def collect(ended=None):
    ended = show_all if ended is None else ended
    rows, seen = [], set()
    for jf in glob.glob(f"{HOME}/sessions/*.json"):
        try: d = json.load(open(jf))
        except Exception: continue
        pid, sid = d.get("pid"), d.get("sessionId")
        live = bool(pid) and alive(pid)
        if not live and not ended: continue
        if d.get("cwd") in (CHAT_DIR, INBOX_DIR): continue
        seen.add(sid)
        tp = transcript(sid)
        st = stats(tp)
        agent_detail(tp, st["agents"], live, d.get("startedAt") or 0)
        rows.append(dict(sid=sid, pid=pid, live=live, status=d.get("status", "?") if live else "ended",
            name=st["title"] or d.get("name"), cwd=st["wd"] or d.get("cwd", ""), kind=d.get("kind", ""),
            entry=d.get("entrypoint", ""), version=d.get("version", ""), started=d.get("startedAt", 0),
            updated=d.get("updatedAt", 0), uptime=etime(pid) if live else "-", **st))
    if ended:
        cutoff = time.time() - 86400
        for p in glob.glob(f"{HOME}/projects/*/*.jsonl"):
            sid = os.path.basename(p)[:-6]
            if sid in seen or os.path.getmtime(p) < cutoff: continue
            st = stats(p)
            if st["wd"] == CHAT_DIR: continue
            agent_detail(p, st["agents"], False, 0)
            rows.append(dict(sid=sid, pid=None, live=False, status="ended", name=st["title"],
                cwd=st["wd"] or os.path.basename(os.path.dirname(p)), kind="", entry="", version="", started=0,
                updated=int(os.path.getmtime(p)*1000), uptime="-", **st))
    rows.sort(key=lambda r: (not r["live"], r["started"] if r["live"] else 0, -r["updated"]))
    return rows

def agent_counts(r):
    ags = r.get("agents") or []
    running = sorted((a for a in ags if a["state"] == "running"), key=lambda a: a["t0"] or 0)
    nrun = sum((a.get("nrun") or 1) if a["kind"] == "workflow" else 1 for a in running)
    ndone = sum(a.get("ndone", 0) if a["kind"] == "workflow" else a["state"] != "running" for a in ags)
    return running, nrun, ndone

def render_table(rows):
    if as_json:
        print(json.dumps(rows, indent=2)); return
    cols = shutil.get_terminal_size((160, 20)).columns
    G, Y, R, D, B, Z = "\033[32m", "\033[33m", "\033[31m", "\033[2m", "\033[1m", "\033[0m"
    if not ISTTY: G = Y = R = D = B = Z = ""
    print(f"{B}{'PID':<7}{'STATUS':<9}{'CONTEXT':<22}{'MODEL':<18}{'TURNS':>5} {'TOOLS':>5} {'OUT':>6} {'CACHE-R':>8} {'UP':>9} {'IDLE':>6}  SESSION{Z}")
    for r in rows:
        w = WINDOW or (1_000_000 if r["peak"] > 200_000 else 200_000)
        pct = r["ctx"] / w * 100
        n = 10; fill = min(n, round(pct / 100 * n))
        col = R if pct >= 85 else Y if pct >= 60 else G
        bar = f"{col}{'█'*fill}{D}{'░'*(n-fill)}{Z} {fmt(r['ctx']):>5} {pct:3.0f}%"
        sc = G if r["status"] == "busy" else Y if r["status"] == "idle" else D
        proj = os.path.basename(r["cwd"].rstrip("/")) or r["cwd"]
        nag = agent_counts(r)[1]
        label = f"{r['name'] or r['title'] or r['sid'][:8]} {D}[{proj}]{Z}" + (f" {Y}· {nag} agent{'s' if nag != 1 else ''}{Z}" if nag else "")
        pid = str(r["pid"] or "-")
        print(f"{pid:<7}{sc}{r['status']:<9}{Z}{bar:<{22+len(col)+len(D)+len(Z)}}{r['model'].replace('claude-',''):<18}"
              f"{r['turns']:>5} {r['tools']:>5} {fmt(r['out']):>6} {fmt(r['cread']):>8} {r['uptime']:>9} {ago(r['updated']) if r['updated'] else '-':>6}  {label}"[:cols+40])
    live = [r for r in rows if r["live"]]
    print(f"{D}{len(live)} live / {len(rows)} shown · ctx = last request input (input+cache) · window assumed {'$CLAUDE_CTX_WINDOW' if WINDOW else '200k, 1M if peak>200k'}{Z}")

import re, unicodedata
_ansi = re.compile(r"\033\[[0-9;]*m")
def vw(t):
    return sum(2 if unicodedata.east_asian_width(c) in "WF" else 0 if unicodedata.combining(c) else 1 for c in _ansi.sub("", t))
def pad(t, w):
    return t + " " * max(0, w - vw(t))
def clip(t, w):
    if vw(t) <= w: return t
    o = ""
    for c in t:
        if vw(o + c) > w - 1: break
        o += c
    return o + "…"

def usage_data():
    try: return json.load(open(f"{HOME}/state/rate-limits.json"))
    except Exception: return None

def usage_line(width):
    tty = ISTTY
    C = lambda n: f"\033[{n}m" if tty else ""
    Z, D, B = C(0), C(2), C(1)
    col = lambda p: C("38;5;167") if p >= 85 else C("38;5;179") if p >= 60 else C("38;5;114")
    d = usage_data()
    if d is None:
        return f"{D} usage limits: no data yet (appears after the next status line refresh){Z}"
    rl, now = d.get("rate_limits") or {}, time.time()
    def rem(sec):
        sec = int(max(0, sec))
        dd, r = divmod(sec, 86400); hh, r = divmod(r, 3600); mm = r // 60
        return f"{dd}d{hh}h" if dd else f"{hh}h{mm:02d}m" if hh else f"{mm}m"
    parts = []
    for key, lab, fmt_t in (("five_hour", "5h", "%H:%M"), ("seven_day", "7d", "%a %H:%M")):
        w = rl.get(key)
        if not w: continue
        pct, rs = float(w.get("used_percentage") or 0), w.get("resets_at")
        if rs and rs < now:
            parts.append(f"{B}{lab}{Z} {D}window reset{Z}")
            continue
        n = 14
        f = min(n, round(pct / 100 * n))
        bar = f"{col(pct)}{'█'*f}{D}{'░'*(n-f)}{Z}"
        when = f" {D}resets{Z} {time.strftime(fmt_t, time.localtime(rs))} {D}(in {rem(rs-now)}){Z}" if rs else ""
        parts.append(f"{B}{lab}{Z} {bar} {col(pct)}{B}{pct:.0f}%{Z}{when}")
    age = rem(now - d.get("ts", now))
    sep = f"  {D}│{Z}  "
    return " " + sep.join(parts) + f"{sep}{D}updated {age} ago{Z}" if parts else f"{D} usage limits: n/a{Z}"

def render(rows):
    if as_json or table:
        return render_table(rows)
    tty = ISTTY
    C = lambda n: f"\033[{n}m" if tty else ""
    TC = lambda n: f"\033[38;5;{n}m" if tty else ""
    Z, B, D = C(0), C(1), C(2)
    CY = TC(81)
    ORANGE, GREEN, AMBER, GRAY, RED, FG = TC(173), TC(114), TC(179), TC(240), TC(167), TC(253)
    WAITGRAY, VIOLET = TC(248), TC(141)
    RAINBOW = [TC(n) for n in (196, 208, 220, 82, 45, 63, 171)]
    SPIN = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
    one = lambda x: " ".join(str(x).split())
    def logo_line(i, r, text):
        if r.get("ultra") and r["live"]:
            ph = FRAME // 2
            return "".join(f"{RAINBOW[(k + ph) % len(RAINBOW)]}{c}" if c != " " else c for k, c in enumerate(text)) + Z
        return f"{ORANGE}{text}{Z}"
    cols = max(shutil.get_terminal_size((120, 20)).columns, 34)
    spark = "▁▂▃▄▅▆▇█"
    logo = [" ▐▛███▜▌  ", "▝▜█████▛▘ ", "  ▘▘ ▝▝   "]

    def state(r):
        st = r["status"]
        if st == "busy": return "RUNNING", ORANGE
        if st == "idle": return "WAITING", WAITGRAY
        if st == "ended": return "ENDED", GRAY
        return st.upper(), AMBER

    live = [r for r in rows if r["live"]]
    nrun = sum(1 for r in live if r["status"] == "busy")
    nwait = sum(1 for r in live if r["status"] == "idle")
    nother = len(live) - nrun - nwait
    nag = sum(agent_counts(r)[1] for r in live)
    head = (f" {ORANGE}{B}✻ Claude sessions{Z}   {ORANGE}●{Z} {nrun} running   {WAITGRAY}●{Z} {nwait} waiting"
            + (f"   {AMBER}●{Z} {nother} other" if nother else "")
            + (f"   {VIOLET}◆{Z} {nag} agent{'s' if nag != 1 else ''}" if nag else "")
            + f"   {D}·  {fmt(sum(r['ctx'] for r in live))} context  ·  {fmt(sum(r['out'] for r in rows))} output  ·  {time.strftime('%H:%M:%S')}{Z}")
    print(head + "\n")

    def tx_box(r, W, bh):
        inner = W - 4
        t = TXD.get(r["sid"]) or dict(log=[], mode="none", app=None, sending=False, err=None)
        label, sc = state(r)
        sel = r["sid"] == SEL
        typing = sel and SEND is not None
        bd = ORANGE if typing else sc if r["status"] != "ended" else GRAY
        TL, TR, BL, BR, HZ, VT, ML, MR = ("╔", "╗", "╚", "╝", "═", "║", "╠", "╣") if sel else ("╭", "╮", "╰", "╯", "─", "│", "├", "┤")
        key = (r["sid"], inner)
        if TX_LINES.get(key, (None,))[0] is not t["log"]: TX_LINES[key] = (t["log"], chat_lines(t["log"], inner))
        log = list(TX_LINES[key][1])
        if t["sending"] or r["status"] == "busy": log.append(f"{ORANGE}{SPIN[FRAME % 10]} Working…{Z}")
        if t["err"]: log.append(f"{RED}✗ {clip(one(t['err']), inner - 2)}{Z}")
        ask = []
        if t.get("pend"):
            pd = t["pend"]
            if pd["plan"] is not None:
                import textwrap
                body = [f"{FG}{x}{Z}" for ln in pd["plan"].splitlines() for x in (textwrap.wrap(ln, inner - 2) or [""])]
                keep = max(1, (bh - 6) // 2)
                ask = [f"{AMBER}{B}◆ the plan waits for you{Z} {D}y approve · d deny · or type a reply{Z}"] + body[:keep] + ([f"{D}  … {len(body) - keep} more lines{Z}"] if len(body) > keep else [])
            else:
                ask = [f"{AMBER}{B}◆ allow {pd['tool']}?{Z} {FG}{clip(one(pd['what']), inner - vw(pd['tool']) - 10)}{Z}", f"{D}y allow · d deny · or type a reply{Z}"]
            ask = [f"{AMBER}{'┄' * inner}{Z}"] + ask
        room = max(1, bh - 4 - len(ask))
        log = [""] * (room - len(log[-room:])) + log[-room:] + ask
        side = clip(f"{label.lower()} · {os.path.basename(r['cwd'].rstrip('/'))}" + (f" · {t['app']}" if t["app"] else ""), max(8, inner // 2))
        title = clip(f"✻ {r['name'] or r['sid'][:8]}", max(4, W - 8 - vw(side)))
        fill = HZ * max(0, W - 8 - vw(title) - vw(side))
        out = [f"{bd}{TL}{HZ}{Z} {ORANGE}{B}{title}{Z} {bd}{fill}{Z} {D}{side}{Z} {bd}{HZ}{TR}{Z}"]
        out += [f"{bd}{VT}{Z} {pad(x, inner)} {bd}{VT}{Z}" for x in log]
        if typing:
            cur = "\033[7m \033[27m" if FRAME // 3 % 2 == 0 else " "
            field = f"{ORANGE}{B}❯{Z} {FG}{B}{SEND[-(inner - 3):] if vw(SEND) > inner - 3 else SEND}{Z}{cur}"
        else:
            ph = ({"owned": "enter: type to it · x " + ("stop" if t["sending"] else "close"), "type": f"enter: type to its {t['app']} tab",
                "resume": "enter: resume it in cs with a message"}.get(t["mode"])
                or (f"runs in {t['app']}: f focuses it" if t["app"] else "no terminal: read-only"))
            field = f"{GRAY}❯{Z} {D}{clip(ph, inner - 2)}{Z}"
        return out + [f"{bd}{ML}{HZ * (W - 2)}{MR}{Z}", f"{bd}{VT}{Z} {pad(field, inner)} {bd}{VT}{Z}", f"{bd}{BL}{HZ * (W - 2)}{BR}{Z}"]

    if VIEW == "tx":
        per = max(1, (cols - 1) // 64)
        W = (cols - 1 - (per - 1)) // per
        # dense packing: each box takes the first free w×h spot from the top, so smaller boxes fill the gaps
        grid, place = [], []
        for r in rows:
            w, h = TX_SIZE.get(r["sid"], (1, 1))
            w, y = min(w, per), 0
            while True:
                while len(grid) < y + h: grid.append([None] * per)
                x = next((x for x in range(per - w + 1) if all(grid[y + i][x + j] is None for i in range(h) for j in range(w))), None)
                if x is not None: break
                y += 1
            for i in range(h):
                for j in range(w): grid[y + i][x + j] = len(place)
            place.append((r, x, y, w, h))
        nrow = max(1, len(grid))
        show = min(nrow, max(1, TX_ROOM // 10))
        bh = max(8, TX_ROOM // show)
        # more rows than fit: scroll so the selected box is on screen
        sp = next((q for q in place if q[0]["sid"] == SEL), None)
        first = min(max(0, sp[2] + sp[4] - show), sp[2], nrow - show) if sp else 0
        TILES.clear()
        y0 = 3
        if show < nrow: print(f"{D} rows {first + 1}–{first + show} of {nrow} · arrows scroll{Z}"); y0 += 1
        boxes = {}
        for k, (r, x, y, w, h) in enumerate(place):
            if y + h > first and y < first + show:
                x0 = x * (W + 1) + 1
                TILES.append(dict(sid=r["sid"], idx=k, x0=x0, x1=x0 + w * (W + 1) - 2, y0=y0 + (y - first) * bh, y1=y0 + (y - first + h) * bh - 1))
                boxes[k] = tx_box(r, w * (W + 1) - 1, h * bh)
        for L in range(first * bh, (first + show) * bh):
            gy, off = divmod(L, bh)
            out, c = [], 0
            while c < per:
                k = grid[gy][c]
                if k is None: out.append(" " * W); c += 1; continue
                _, x, y, w, h = place[k]
                out.append(boxes[k][(gy - y) * bh + off]); c += w
            print(" ".join(out))
        if not rows: print(f"{D} no sessions{Z}")
        return

    def agent_block(r, iw):
        ags = r.get("agents") or []
        if not ags: return []
        now = time.time()
        running, nrun, ndone = agent_counts(r)
        recent = sorted((a for a in ags if a["state"] not in ("running", "lost") and a["t1"] and now - a["t1"] < 60), key=lambda a: -a["t1"])
        head = (f"{D}AGENTS{Z}" + (f" {ORANGE}{B}{nrun}{Z} {D}running{Z}" if nrun else "") + (f" {D}·{Z}" if nrun and ndone else "")
                + (f" {FG}{ndone}{Z} {D}done{Z}" if ndone else ""))
        show, more = running + recent, 0
        if len(show) > AGENT_ROWS: show, more = show[:AGENT_ROWS - 1], len(show) - AGENT_ROWS + 1
        short = lambda a: {"general-purpose": "general", "claude-code-guide": "guide", "statusline-setup": "statusline"}.get(a["type"], a["type"])
        tw = min(10, max((vw(short(a)) for a in show), default=0))
        out = ["", head]
        for k, a in enumerate(show):
            on = a["state"] == "running"
            if on:
                ic = f"{ORANGE}{SPIN[(FRAME + k * 3) % 10]}{Z}"
                act = f"{a['phase'] or 'running'} {a['ndone']}/{a['ndone'] + a['nrun']}" if a["kind"] == "workflow" else a.get("act") or "starting"
                right = f"{act} {dur(now - (a['t0'] or now))}"
            else:
                ic = f"{WAITGRAY}✓{Z}" if a["state"] == "completed" else f"{RED}✗{Z}" if a["state"] == "failed" else f"{GRAY}■{Z}"
                right = f"{'done' if a['state'] == 'completed' else a['state']} {dur(a['t1'] - (a['t0'] or a['t1']))}"
            right = clip(right, max(6, iw // 3))
            left = f"{ic} {VIOLET if on else D}{pad(clip(short(a), tw), tw)}{Z} "
            mw = max(1, iw - vw(left) - vw(right) - 1)
            out.append(left + pad(f"{FG if on else D}{clip(one(a['desc']) or '-', mw)}{Z}", mw) + f" {D}{right}{Z}")
        if more: out.append(f"{D}  +{more} more{Z}")
        return out

    def make(r, W, ablock):
        iw = W - 8
        label, sc = state(r)
        busy = r["status"] == "busy"
        w = WINDOW or (1_000_000 if r["peak"] > 200_000 else 200_000)
        pct = min(100.0, r["ctx"] / w * 100)
        bc = RED if pct >= 85 else AMBER if pct >= 60 else sc if r["status"] != "ended" else GRAY
        proj = os.path.basename(r["cwd"].rstrip("/")) or r["cwd"]
        ent = {"claude-vscode": "VS Code", "cli": "CLI"}.get(r["entry"], r["entry"] or "")
        tag = clip(f"#{r['pid']}" + (f" · {ent}" if ent else "") if r["pid"] else "transcript", W - 8)
        bd = sc if r["status"] != "ended" else GRAY
        tw = iw - 11
        fill = round(pct / 100 * iw)
        bar = f"{bc}{'█'*fill}{GRAY}{'░'*(iw-fill)}{Z}"
        hist = r["hist"]
        sp = ""
        if hist:
            pts = [hist[int(i * len(hist) / iw)] for i in range(iw)]
            sp = "".join(spark[min(7, int(v / w * 8))] for v in pts)
        half = iw // 2
        def pair(l1, v1, l2, v2):
            return pad(f"{D}{l1}{Z} {FG}{v1}{Z}", half) + f"{D}{l2}{Z} {FG}{v2}{Z}"
        home = os.path.expanduser("~")
        wd = r["cwd"]
        if wd.startswith(home): wd = "~" + wd[len(home):]
        dw = iw - 5
        if vw(wd) > dw: wd = "…" + wd[-(dw - 1):]
        br = r["branch"] if r["branch"] and r["branch"] != "HEAD" else ""
        brl = f"{CY}{clip(br, dw)}{Z}" if br else f"{D}none{Z}"
        if r["status"] == "busy":
            tt = one(r["cur_task"] or r["prompt"])
            task_l = f"{ORANGE}▶{Z} {FG}{clip(tt, dw - 2)}{Z}" if tt else f"{D}working…{Z}"
        else:
            tt = one(r["done_task"] or r["prompt"])
            task_l = f"{WAITGRAY}✓{Z} {D}{clip(tt, dw - 2)}{Z}" if tt else f"{D}—{Z}"
        lines = [
            "",
            "",
            f"{logo_line(0, r, logo[0])}{B}{FG}{clip(r['name'] or r['sid'][:8], tw)}{Z}",
            f"{logo_line(1, r, logo[1])}{sc}{'●' if not busy or FRAME // 4 % 2 == 0 else '○'}{Z} {sc}{B}{label}{Z}" + (f" {sc}{'⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'[FRAME % 10]}{Z}" if busy else ""),
            logo_line(2, r, logo[2] if not busy else logo[2][::-1] if FRAME // 3 % 2 else logo[2]),
            "",
            f"{D}dir{Z}  {FG}{wd}{Z}",
            f"{D}git{Z}  {brl}",
            f"{D}task{Z} {task_l}",
            *ablock,
            "",
            pad(f"{D}CONTEXT{Z} {FG}{fmt(r['ctx'])}{D}/{fmt(w)}{Z}", iw - 4) + f"{bc}{B}{pct:3.0f}%{Z}",
            bar,
            bar,
            "",
            f"{D}MODEL{Z} {FG}{clip(r['model'].replace('claude-',''), iw-6)}{Z}",
            pair("turns", r["turns"], "tools", r["tools"]),
            pair("out", fmt(r["out"]), "cache", fmt(r["cread"])),
            pair("up", r["uptime"], "idle", ago(r["updated"]) if r["updated"] else "-"),
            "",
            "",
        ]
        nd = max(0, W - 5 - vw(tag))
        if busy and nd:
            pos = FRAME % (nd + 6) - 6
            dashes = "".join(f"{FG}{B}━{Z}{bd}" if 0 <= i - pos < 6 else "─" for i in range(nd))
        else:
            dashes = "─" * nd
        sel = r["sid"] == SEL
        TL, TR, BL, BR, HZ, VT = ("╔", "╗", "╚", "╝", "═", "║") if sel else ("╭", "╮", "╰", "╯", "─", "│")
        if sel: dashes = dashes.replace("─", "═")
        top = f"{bd}{B if sel else ''}{TL}{HZ} {D}{tag}{Z}{bd}{B if sel else ''} " + dashes + f"{TR}{Z}"
        t = [top]
        for ln in lines:
            t.append(f"{bd}{VT}{Z}   {pad(ln, iw)}   {bd}{VT}{Z}")
        t.append(f"{bd}{BL}{HZ*(W-2)}{BR}{Z}")
        return t

    avail = cols - 1
    per = max(1, avail // 52)
    base, extra = divmod(avail - (per - 1), per)
    ws = [base + (1 if j < extra else 0) for j in range(per)]
    if tty and not watch:
        sys.stdout.write("\033[H\033[2J")
    TILES.clear()
    y0 = 3
    for i in range(0, len(rows), per):
        chunk = rows[i:i+per]
        blocks = [agent_block(r, ws[j] - 8) for j, r in enumerate(chunk)]
        nb = max(map(len, blocks))
        tiles = [make(r, ws[j], blocks[j] + [""] * (nb - len(blocks[j]))) for j, r in enumerate(chunk)]
        for j, r in enumerate(chunk):
            x0 = sum(ws[:j]) + j + 1
            TILES.append(dict(sid=r["sid"], idx=i + j, x0=x0, x1=x0 + ws[j] - 1, y0=y0, y1=y0 + len(tiles[0]) - 1))
        y0 += len(tiles[0])
        for ln in zip(*tiles):
            print(" ".join(ln))
    print(f"{D} ctx = last request input · window {'$CLAUDE_CTX_WINDOW' if WINDOW else '200k, 1M if peak>200k'} · -o once · -t table · -a all · -j json{Z}")

def _run(cmd, **kw):
    if os.environ.get("CS_DRY"):
        print("DRY", " ".join(map(str, cmd))[:300], file=sys.stderr)
        return subprocess.CompletedProcess(cmd, 0, "", "")
    return subprocess.run(cmd, **kw)

def ps_info():
    try: ps = subprocess.check_output(["ps", "-axo", "pid=,ppid=,tty=,command="], text=True)
    except Exception: return {}
    info = {}
    for ln in ps.splitlines():
        parts = ln.split(None, 3)
        if len(parts) == 4 and parts[0].isdigit() and parts[1].isdigit():
            info[int(parts[0])] = (int(parts[1]), parts[2], parts[3])
    return info

def term_of(r, info):
    chain, cur = [], r.get("pid")
    while cur in info and len(chain) < 40:
        ppid, _, cmd = info[cur]
        chain.append(cmd)
        if ppid <= 1: break
        cur = ppid
    if not chain: return None, ""
    tty = info[r["pid"]][1]
    dev = f"/dev/{tty}" if tty and tty != "??" else ""
    if r.get("entry") == "claude-vscode" or ".vscode/extensions" in chain[0]:
        return ("Cursor" if ".cursor" in chain[0] else "Visual Studio Code"), dev
    apps = [m.group(1) for m in (re.search(r"/([^/]+)\.app/", c) for c in chain) if m]
    return next((x for x in apps if x != "Claude"), None), dev

def focus(r):
    pid = r.get("pid")
    if owned(r["sid"]): return "this session runs inside cs: open it in transcripts (v in the TUI, 3 on the web)"
    if not (r.get("live") and pid): return "session not running"
    info = ps_info()
    if not info: return "ps failed"
    app, dev = term_of(r, info)
    if not app: return "terminal app not found"
    cwd = r.get("cwd") or ""
    if app in ("Visual Studio Code", "Cursor", "Code", "Windsurf") or "Code" in app:
        name = {"Code": "Visual Studio Code"}.get(app, app)
        _run(["open", "-a", name] + ([cwd] if os.path.isdir(cwd) else []), timeout=8)
        return f"focused {name} → {os.path.basename(cwd)}"
    tty = dev[5:]
    script = None
    if app == "Terminal" and dev:
        script = f'''tell application "Terminal"
activate
repeat with w in windows
repeat with t in tabs of w
if tty of t is "{dev}" then
set selected of t to true
set index of w to 1
return "ok"
end if
end repeat
end repeat
end tell'''
    elif app.startswith("iTerm") and dev:
        script = f'''tell application "iTerm"
activate
repeat with w in windows
repeat with t in tabs of w
repeat with s in sessions of t
if tty of s is "{dev}" then
select w
select t
select s
return "ok"
end if
end repeat
end repeat
end repeat
end tell'''
    if script:
        res = _run(["osascript", "-e", script], capture_output=True, text=True, timeout=10)
        if res.returncode == 0: return f"focused {app} tab {tty}"
        return f"{app}: {res.stderr.strip()[:80] or 'osascript failed'}"
    _run(["open", "-a", app], timeout=8)
    return f"focused {app} (this app can't select a specific tab)"

def tool_line(x):
    inp = x.get("input") or {}
    arg = next((v for v in inp.values() if isinstance(v, str)), "")
    return f"$ {inp['command']}" if inp.get("command") else f"{x.get('name', '').split('__')[-1]} {arg}"

TX_CACHE = {}

def chatlog(path):
    try: key = (os.path.getmtime(path), os.path.getsize(path))
    except (OSError, TypeError): return []
    hit = TX_CACHE.get(path)
    if hit and hit[0] == key: return hit[1]
    log = []
    with open(path, errors="ignore") as f:
        for line in f:
            try: d = json.loads(line)
            except Exception: continue
            if d.get("isSidechain") or d.get("isMeta"): continue
            c = (d.get("message") or {}).get("content")
            if d.get("type") == "user":
                text = c if isinstance(c, str) else " ".join(x.get("text", "") for x in c if isinstance(x, dict) and x.get("type") == "text") if isinstance(c, list) else ""
                cmd = tag(text, "command-name")
                if cmd: log.append(("you", f"{cmd} {tag(text, 'command-args') or ''}".strip()))
                elif text.strip() and not text.lstrip().startswith("<"): log.append(("you", text.strip()))
            elif d.get("type") == "assistant" and isinstance(c, list):
                for x in c:
                    if not isinstance(x, dict): continue
                    if x.get("type") == "text" and x.get("text", "").strip(): log.append(("claude", x["text"].strip()))
                    elif x.get("type") == "tool_use": log.append(("tool", tool_line(x)))
    TX_CACHE[path] = (key, log)
    return log

OWNED, OWN_LOCK = {}, threading.Lock()
OWN_MODES = ("default", "plan", "acceptEdits")

def owned(sid):
    o = OWNED.get(sid)
    return o if o and o["p"].poll() is None else None

def own_write(o, obj):
    try:
        with OWN_LOCK:
            o["p"].stdin.write(json.dumps(obj) + "\n")
            o["p"].stdin.flush()
        return None
    except (OSError, ValueError) as e:
        return f"the session's claude is gone: {e}"

def own_read(sid, o):
    for line in o["p"].stdout:
        try: d = json.loads(line)
        except Exception: continue
        t = d.get("type")
        if t == "control_request" and (d.get("request") or {}).get("subtype") == "can_use_tool":
            r = d["request"]
            o["pend"] = dict(id=d["request_id"], tool=r.get("tool_name") or "", input=r.get("input") or {},
                what=tool_line(dict(name=r.get("tool_name"), input=r.get("input"))))
        elif t == "control_cancel_request" and o["pend"] and o["pend"]["id"] == d.get("request_id"):
            o["pend"] = None
        elif t == "result":
            o["busy"], o["pend"] = False, None
            o["err"] = str(d.get("result") or d.get("subtype"))[:200] if d.get("is_error") else None
    o["p"].wait()
    o["busy"], o["pend"] = False, None
    if o["p"].returncode and not o["closed"]:
        try: last = [l for l in open(o["log"], errors="ignore").read().splitlines() if l.strip()][-1:]
        except OSError: last = []
        o["err"] = (last[0] if last else f"claude exited with code {o['p'].returncode}")[:200]

def own_start(cwd, sid=None, mode="default", text=""):
    import uuid
    if not os.path.isdir(cwd): return None, f"not a folder: {cwd}"
    if mode not in OWN_MODES: return None, f"unknown permission mode: {mode}"
    if sid and owned(sid): return sid, None
    resume, sid = bool(sid), sid or str(uuid.uuid4())
    claude = shutil.which("claude") or os.path.expanduser("~/.local/bin/claude")
    log = f"{HOME}/state/cs-own-{sid[:8]}.log"
    # --permission-prompt-tool stdio: permission prompts and plan approval come to us as control requests
    cmd = [claude, "-p", "--input-format", "stream-json", "--output-format", "stream-json", "--verbose",
        "--permission-prompt-tool", "stdio", "--permission-mode", mode, "--resume" if resume else "--session-id", sid]
    try:
        with open(log, "w") as f:
            proc = subprocess.Popen(cmd, cwd=cwd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=f, text=True, bufsize=1)
    except OSError as e:
        return None, f"cannot start claude: {e}"
    o = OWNED[sid] = dict(p=proc, cwd=cwd, busy=False, pend=None, err=None, log=log, closed=False)
    threading.Thread(target=own_read, args=(sid, o), daemon=True).start()
    if text.strip():
        o["busy"] = True
        err = own_write(o, dict(type="user", message=dict(role="user", content=text.strip())))
        if err: return None, err
    return sid, None

def own_answer(sid, allow, note=""):
    o = owned(sid)
    if not o or not o["pend"]: return "nothing to answer"
    pend, o["pend"] = o["pend"], None
    res = dict(behavior="allow", updatedInput=pend["input"]) if allow else dict(behavior="deny", message=note or "The user denied this.")
    return own_write(o, dict(type="control_response", response=dict(subtype="success", request_id=pend["id"], response=res))) or (
        f"allowed {pend['tool']}" if allow else f"denied {pend['tool']}" + (" with your reply" if note else ""))

def own_stop(sid):
    import uuid
    o = owned(sid)
    if not o: return "this session isn't run by cs"
    if o["busy"]:
        return own_write(o, dict(type="control_request", request_id=str(uuid.uuid4()), request=dict(subtype="interrupt"))) or "interrupted"
    o["closed"] = True
    o["p"].terminate()
    return "closed the session: resume it from here or in a terminal"

def send_mode(r, info):
    if owned(r["sid"]): return dict(mode="owned", app="cs")
    if not r.get("live"): return dict(mode="resume", app=None)
    app, dev = term_of(r, info)
    return dict(mode="type" if dev and (app == "Terminal" or (app or "").startswith("iTerm")) else "none", app=app)

def transcript_of(r, info):
    o = OWNED.get(r["sid"])
    pend = o and o["pend"] and dict(tool=o["pend"]["tool"], what=o["pend"]["what"], plan=o["pend"]["input"].get("plan") if o["pend"]["tool"] == "ExitPlanMode" else None)
    return dict(log=chatlog(transcript(r["sid"]))[-60:], **send_mode(r, info), sending=bool(o and o["busy"] and not o["pend"]), err=o and o["err"], pend=pend)

def session_send(r, text):
    text = text.strip()
    if not text: return "nothing to send"
    info = ps_info()
    m = send_mode(r, info)
    if m["mode"] == "owned":
        o = OWNED[r["sid"]]
        if o["pend"]: return own_answer(r["sid"], False, text)
        o["busy"], o["err"] = True, None
        return own_write(o, dict(type="user", message=dict(role="user", content=text))) or "sent"
    if m["mode"] == "none":
        return f"this session runs in {m['app']}: focus it to type there" if m["app"] else "this session has no terminal to type into"
    if m["mode"] == "resume":
        cwd = r["cwd"] if os.path.isdir(r["cwd"]) else os.path.expanduser("~")
        _, err = own_start(cwd, r["sid"], "default", text)
        return err or "resumed the session in cs: answer its prompts here"
    _, dev = term_of(r, info)
    # shortcut: a typed newline submits, so newlines become spaces; upgrade to bracketed paste if multi-line messages matter
    q = lambda x: x.replace("\\", "\\\\").replace('"', '\\"')
    line = q(" ".join(text.split()))
    if m["app"] == "Terminal":
        script = (f'tell application "Terminal"\nrepeat with w in windows\nrepeat with t in tabs of w\nif tty of t is "{dev}" then\n'
            f'do script "{line}" in t\nreturn "ok"\nend if\nend repeat\nend repeat\nend tell')
    else:
        script = (f'tell application "iTerm"\nrepeat with w in windows\nrepeat with t in tabs of w\nrepeat with s in sessions of t\n'
            f'if tty of s is "{dev}" then\ntell s to write text "{line}"\nreturn "ok"\nend if\nend repeat\nend repeat\nend repeat\nend tell')
    res = _run(["osascript", "-e", script], capture_output=True, text=True, timeout=10)
    if res.returncode: return f"{m['app']}: {res.stderr.strip()[:80] or 'osascript failed'}"
    return f"sent to {m['app']} tab {dev[5:]}" if res.stdout.strip() == "ok" or os.environ.get("CS_DRY") else f"{m['app']} tab {dev[5:]} not found"

def settings():
    try: c = json.load(open(SETTINGS, encoding="utf-8"))
    except (OSError, ValueError): c = {}
    return c if isinstance(c, dict) else {}

def save_settings(**kw):
    with SLOCK:
        c = settings()
        c.update(kw)
        tmp = SETTINGS + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f: f.write(json.dumps(c, indent=2, ensure_ascii=False) + "\n")
        os.replace(tmp, SETTINGS)

def repo_roots():
    raw = os.environ.get("CS_REPO_ROOTS") or settings().get("projects") or "~/Projects"
    return [r for r in (os.path.expanduser(x.strip()).rstrip("/") for x in str(raw).split(":")) if os.path.isdir(r)]

def find_repos():
    found = []
    for root in repo_roots():
        base = root.count("/")
        for dp, dns, fns in os.walk(root):
            if ".git" in dns or ".git" in fns:
                found.append(dp); dns[:] = []; continue
            if dp.count("/") - base >= 3: dns[:] = []
            dns[:] = [x for x in dns if not x.startswith(".") and x not in ("node_modules", "vendor")]
    return sorted(set(found))[:400]

def projects():
    roots, repos = repo_roots(), find_repos()
    enc = {re.sub(r"[^A-Za-z0-9]", "-", r): r for r in repos}
    used = {}
    try: dirs = os.listdir(f"{HOME}/projects")
    except OSError: dirs = []
    for d in dirs:
        e = max((e for e in enc if d == e or d.startswith(e + "-")), key=len, default=None)
        if not e: continue
        for f in glob.glob(f"{HOME}/projects/{glob.escape(d)}/*.jsonl"):
            try: used[enc[e]] = max(used.get(enc[e], 0), os.path.getmtime(f))
            except OSError: pass
    names = [os.path.basename(r) for r in repos]
    rel = lambda r: next((r[len(x) + 1:] for x in roots if r.startswith(x + "/")), os.path.basename(r))
    out = [dict(path=r, name=n if names.count(n) == 1 else "/".join(r.split("/")[-2:]), rel=rel(r), t=used.get(r, 0))
        for r, n in zip(repos, names)]
    return sorted(out, key=lambda p: (-p["t"], p["rel"].lower()))

def proj_match(q, items):
    q = q.lower().strip()
    if not q: return items
    def score(p):
        n, r = p["name"].lower(), p["rel"].lower()
        if n.startswith(q): return 0
        if q in n: return 1
        if q in r: return 2
        it = iter(r)
        return 3 if all(c in it for c in q.replace(" ", "")) else None
    hits = [(score(p), i, p) for i, p in enumerate(items)]
    return [p for sc, i, p in sorted((h for h in hits if h[0] is not None), key=lambda h: h[:2])]

def open_project(path):
    p = next((x for x in projects() if x["path"] == path), None)
    if not p: return "project not found"
    r = _run(["open", "-a", "Visual Studio Code", p["path"]], capture_output=True, text=True)
    return f"opened {p['name']} in VS Code" if r.returncode == 0 else f"could not open VS Code: {(r.stderr or '').strip()[:120]}"

def proj_view(cols):
    T = lambda n: f"\033[38;5;{n}m"
    Z, B, D = "\033[0m", "\033[1m", "\033[2m"
    ORANGE, FG, CY = T(173), T(253), T(81)
    hits, out = [], " "
    roots = repo_roots()
    folder = ":".join(r.replace(os.path.expanduser("~"), "~", 1) for r in roots) or "no projects folder"
    if PSEARCH is None:
        recent = [p for p in PROJ if p["t"]] or PROJ
        right = f"{D}p search · {folder}{Z}"
        out += f"{D}projects{Z}  "
        room = cols - 1 - vw(right) - 2
        n = 0
        for p in recent:
            sep = f"{D} · {Z}" if n else ""
            more = f"{D} · +{len(PROJ) - n - 1}{Z}" if len(PROJ) - n - 1 > 0 else ""
            if vw(out + sep + p["name"] + more) > room: break
            out += sep
            hits.append((vw(out) + 1, vw(out) + vw(p["name"]), p["path"]))
            out += f"{FG}{p['name']}{Z}"
            n += 1
        if len(PROJ) > n: out += f"{D}{' · ' if n else ''}+{len(PROJ) - n}{Z}"
        if not PROJ: out += f"{D}no git repos in {folder}{Z}"
    else:
        found = proj_match(PSEARCH, PROJ)
        sel = min(PSEL, max(0, len(found) - 1))
        cur = "\033[7m \033[27m" if FRAME // 3 % 2 == 0 else " "
        out += f"{ORANGE}{B}❯{Z} {FG}{B}{PSEARCH}{Z}{cur}{'' if PSEARCH else D + 'search projects' + Z}  "
        right = f"{D}{len(found)} found{Z}"
        room = cols - 1 - vw(right) - 2
        start = 0
        while True:
            line, hs = out, []
            for i, p in enumerate(found[start:], start):
                sep = f"{D} · {Z}" if hs else ""
                label = f"▸ {p['name']}" if i == sel else p["name"]
                if vw(line + sep + label) > room: break
                line += sep
                hs.append((vw(line) + 1, vw(line) + vw(label), p["path"]))
                line += f"{ORANGE}{B}{label}{Z}" if i == sel else f"{FG}{p['name']}{Z}"
            if start >= sel or any(h[2] == found[sel]["path"] for h in hs): break
            start = sel
        out, hits = line, hs
        if not found: out += f"{D}no match{Z}"
    return out + " " * max(1, cols - 1 - vw(out) - vw(right)) + right, hits

TASK_STATUS = ("new", "queued", "analyzing", "awaiting_approval", "implementing", "in_review", "needs_info", "done", "rejected", "failed")
TASK_KINDS, TASK_PRIO = ("fix", "check"), ("high", "medium", "low")
TDB_READY = False

def tdb():
    global TDB_READY
    import sqlite3
    os.makedirs(os.path.dirname(TASKS_DB), exist_ok=True)
    c = sqlite3.connect(TASKS_DB, timeout=10)
    c.row_factory = sqlite3.Row
    c.execute("PRAGMA foreign_keys = ON")
    if not TDB_READY:
        c.execute("PRAGMA journal_mode = WAL")
        c.executescript("""
CREATE TABLE IF NOT EXISTS tasks (
  id INTEGER PRIMARY KEY AUTOINCREMENT, client TEXT NOT NULL, repo TEXT, parent_id INTEGER REFERENCES tasks(id) ON DELETE CASCADE,
  kind TEXT NOT NULL DEFAULT 'fix', title TEXT NOT NULL, summary TEXT NOT NULL DEFAULT '', priority TEXT,
  status TEXT NOT NULL DEFAULT 'new', source TEXT NOT NULL DEFAULT 'manual', thread_id TEXT, session_id TEXT,
  branch TEXT, result TEXT, created REAL NOT NULL, updated REAL NOT NULL);
CREATE TABLE IF NOT EXISTS task_events (
  id INTEGER PRIMARY KEY, task_id INTEGER NOT NULL REFERENCES tasks(id) ON DELETE CASCADE,
  t REAL NOT NULL, kind TEXT NOT NULL, text TEXT NOT NULL DEFAULT '');
CREATE INDEX IF NOT EXISTS task_events_task ON task_events(task_id);
CREATE TABLE IF NOT EXISTS threads (
  id TEXT PRIMARY KEY, last_id TEXT, date TEXT, sender TEXT, subject TEXT, snippet TEXT, url TEXT,
  outcome TEXT NOT NULL, reason TEXT, guess TEXT, task_id INTEGER REFERENCES tasks(id) ON DELETE SET NULL, t REAL NOT NULL);
CREATE TABLE IF NOT EXISTS feedback (
  id INTEGER PRIMARY KEY AUTOINCREMENT, t REAL NOT NULL, sender TEXT, subject TEXT, verdict TEXT NOT NULL);
CREATE TABLE IF NOT EXISTS scans (
  id INTEGER PRIMARY KEY AUTOINCREMENT, t0 REAL NOT NULL, t1 REAL, trigger TEXT, query TEXT, ok INTEGER NOT NULL DEFAULT 0,
  found INTEGER NOT NULL DEFAULT 0, created INTEGER NOT NULL DEFAULT 0, updated INTEGER NOT NULL DEFAULT 0,
  skipped INTEGER NOT NULL DEFAULT 0, cost REAL, error TEXT);
""")
        cols = {r[1] for r in c.execute("PRAGMA table_info(tasks)")}
        if "report" not in cols: c.execute("ALTER TABLE tasks ADD COLUMN report TEXT")
        TDB_READY = True
    return c

def task_q(fn):
    from contextlib import closing
    with closing(tdb()) as c, c: return fn(c)

def repo_rel(path, roots=None):
    return next((path[len(r) + 1:] for r in roots or repo_roots() if path.startswith(r + "/")), os.path.basename(path))

def client_of(path, roots=None):
    return repo_rel(path, roots).split("/")[0]

def project_index():
    roots = repo_roots()
    rels = {repo_rel(r, roots): r for r in find_repos()}
    return rels, {k.split("/")[0] for k in rels}

def task_project(v, idx=None):
    rels, clients = idx or project_index()
    v = os.path.expanduser(str(v or "").strip()).rstrip("/")
    hit = next((rel for rel, path in rels.items() if v in (rel, path)), None)
    if hit: return hit.split("/")[0], rels[hit]
    if v and v in clients: return v, None
    return None

def task_fields(body):
    f = {}
    if "project" in body:
        p = task_project(body["project"])
        if not p: return f"not a repo or client folder in the projects folder: {body['project']}"
        f["client"], f["repo"] = p
    if "title" in body:
        f["title"] = " ".join(str(body["title"] or "").split())[:200]
        if not f["title"]: return "the title is empty"
    if "summary" in body: f["summary"] = str(body["summary"] or "").strip()[:20000]
    for k, ok in (("kind", TASK_KINDS), ("status", TASK_STATUS), ("priority", TASK_PRIO + (None,))):
        if k in body:
            f[k] = body[k] or None
            if f[k] not in ok: return f"bad {k}: {body[k]}"
    return f

def task_event(c, tid, kind, text, now):
    c.execute("INSERT INTO task_events (task_id, t, kind, text) VALUES (?, ?, ?, ?)", (tid, now, kind, text))

def task_insert(c, f, now, parent=None, source="manual", thread=None, note="by hand"):
    tid = c.execute("INSERT INTO tasks (client, repo, parent_id, kind, title, summary, priority, status, source, thread_id, created, updated) "
        "VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)", (f["client"], f["repo"], parent, f.get("kind") or "fix", f["title"],
        f.get("summary", ""), f.get("priority"), f.get("status") or "new", source, thread, now, now)).lastrowid
    task_event(c, tid, "created", note, now)
    return tid

def feedback(c, thread, verdict, now):
    th = c.execute("SELECT sender, subject FROM threads WHERE id = ?", (thread,)).fetchone()
    if th: c.execute("INSERT INTO feedback (t, sender, subject, verdict) VALUES (?, ?, ?, ?)", (now, th["sender"], th["subject"], verdict))

def proj_label(client, repo):
    return repo_rel(repo) if repo else client

def task_list():
    roots = repo_roots()
    return task_q(lambda c: [dict(r, rel=r["repo"] and repo_rel(r["repo"], roots)) for r in c.execute("SELECT * FROM tasks ORDER BY id")])

def task_get(tid):
    def run(c):
        r = c.execute("SELECT * FROM tasks WHERE id = ?", (tid,)).fetchone()
        if not r: return None
        ev = [dict(e) for e in c.execute("SELECT t, kind, text FROM task_events WHERE task_id = ? ORDER BY id", (tid,))]
        th = r["thread_id"] and c.execute("SELECT sender, subject, date, url, snippet FROM threads WHERE id = ?", (r["thread_id"],)).fetchone()
        return dict(r, rel=r["repo"] and repo_rel(r["repo"]), events=ev, thread=th and dict(th))
    t = task_q(run)
    if t and t["branch"]:
        try: t["changes"] = task_changes(t)
        except (OSError, subprocess.SubprocessError): t["changes"] = None
    return t

def task_save(body):
    f = task_fields(body)
    if isinstance(f, str): return None, f
    now, note = time.time(), str(body.get("note") or "").strip()[:5000]
    def create(c):
        parent, th = None, None
        if body.get("parent_id") is not None:
            parent = c.execute("SELECT * FROM tasks WHERE id = ?", (body["parent_id"],)).fetchone()
            if not parent: return "parent task not found"
            if "client" not in f: f["client"], f["repo"] = parent["client"], parent["repo"]
        if body.get("thread_id"):
            th = c.execute("SELECT * FROM threads WHERE id = ?", (str(body["thread_id"]),)).fetchone()
            if not th: return "email thread not found"
            if th["outcome"] == "task" and th["task_id"]: return f"this email is already task #{th['task_id']}"
        if "client" not in f: return "pick a project"
        if "title" not in f: return "the title is empty"
        tid = task_insert(c, f, now, parent and parent["id"], "email" if th else "manual", th and th["id"],
            f"subtask of #{parent['id']}" if parent else f"from email · {th['sender']}" if th else "by hand")
        if th:
            c.execute("UPDATE threads SET outcome = 'task', task_id = ?, reason = 'made a task by you', t = ? WHERE id = ?", (tid, now, th["id"]))
            feedback(c, th["id"], f"task for {proj_label(f['client'], f['repo'])}", now)
        return tid
    def edit(c, tid):
        old = c.execute("SELECT * FROM tasks WHERE id = ?", (tid,)).fetchone()
        if not old: return "task not found"
        dismiss = bool(body.get("dismiss")) and old["source"] == "email"
        if dismiss: f["status"] = "rejected"
        ch = {k: v for k, v in f.items() if old[k] != v}
        if ch or note: c.execute(f"UPDATE tasks SET {''.join(k + ' = ?, ' for k in ch)}updated = ? WHERE id = ?", (*ch.values(), now, tid))
        if "status" in ch: task_event(c, tid, "status", f"{old['status']} → {ch['status']}", now)
        other = sorted({"project" if k in ("client", "repo") else k for k in ch if k != "status"})
        if other: task_event(c, tid, "edited", ", ".join(other), now)
        if note: task_event(c, tid, "note", note, now)
        if old["thread_id"] and dismiss:
            feedback(c, old["thread_id"], "not a task", now)
            task_event(c, tid, "learned", "not a task: later scans treat mail like this one as not a task", now)
        elif old["thread_id"] and ("client" in ch or "repo" in ch):
            p = proj_label(f["client"], f["repo"])
            feedback(c, old["thread_id"], f"task for {p}", now)
            task_event(c, tid, "learned", f"later scans file mail like this one under {p}", now)
        return tid
    try: tid = None if body.get("id") is None else int(body["id"])
    except (TypeError, ValueError): return None, "bad id"
    r = task_q(create if tid is None else lambda c: edit(c, tid))
    return (None, r) if isinstance(r, str) else (task_get(r), None)

def task_delete(tid):
    return task_q(lambda c: c.execute("DELETE FROM tasks WHERE id = ?", (tid,)).rowcount)

GMAIL = "mcp__claude_ai_Gmail__"
